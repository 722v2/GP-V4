# ── Copy to .env and fill. NEVER commit real values. ─────────────────────

# Operation mode: ANALYSIS_ONLY | MANUAL_CONFIRMATION | AUTO_TRADING | PAPER_TRADING | REPLAY | BACKTEST
GP_MODE=ANALYSIS_ONLY

# ── Symbols / scanning ──
GP_SYMBOLS=XAUUSD
GP_TIMEFRAMES=M5,M15,H1
GP_SCAN_INTERVAL_MS=60000

# ── Biquiti market data (contract UNVERIFIED — endpoint paths come from config, do not invent) ──
BIQUITI_BASE_URL=
BIQUITI_API_KEY=
BIQUITI_CANDLES_PATH=
BIQUITI_AUTH_HEADER=
BIQUITI_SYMBOL_MAP_XAUUSD=
BIQUITI_TIMEOUT_MS=10000

# ── Novita AI provider ──
NOVITA_BASE_URL=
NOVITA_API_KEY=
NOVITA_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
AI_HOURLY_BUDGET_USD=1.00
AI_DAILY_BUDGET_USD=10.00
AI_CACHE_TTL_MS=120000

# ── Supabase persistence ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Telegram control/monitoring ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Risk (defaults for non-live modes; production values set via runtime config) ──
RISK_PER_TRADE_PCT=0.5
RISK_DAILY_LOSS_CAP_PCT=3
RISK_WEEKLY_LOSS_CAP_PCT=6
RISK_MAX_DRAWDOWN_PCT=10
RISK_MAX_OPEN_TRADES=2
RISK_NET_EXPOSURE_MAX=1.5
RISK_MARGIN_CEILING_PCT=50
RISK_ACCOUNT_EQUITY=10000

# ── Spread / slippage model (paper/replay/backtest) ──
MODEL_SPREAD_POINTS=0.35
MODEL_SLIPPAGE_POINTS=0.2
MODEL_LATENCY_MS=250

# ── Replay / backtest fixtures ──
FIXTURES_DIR=./fixtures
